# Release 签名配置模板：复制为 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 排除，不会入库。
# 安全建议：口令不要落明文文件——优先用环境变量或 ~/.gradle/gradle.properties 提供：
#   FINCH_KEYSTORE_FILE / FINCH_KEYSTORE_PASSWORD / FINCH_KEY_ALIAS / FINCH_KEY_PASSWORD
# （环境变量或 gradle.properties 优先级高于本文件；都没有则产出未签名 APK。）
storeFile=E:/path/to/your.keystore
storePassword=xxxxxx
keyAlias=finch
keyPassword=xxxxxx
